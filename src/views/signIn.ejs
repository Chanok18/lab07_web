<%- include('partials/header') %>
<div class="card auth-card">
    <form id="signin-form" class="card-content" novalidate>
        <span class="card-title">Iniciar sesión</span>
        <div class="input-field">
            <i class="material-icons prefix">email</i>
            <input id="email" type="email" class="validate" autocomplete="username" required>
            <label for="email">Email</label>
        </div>
        <div class="input-field">
            <i class="material-icons prefix">lock</i>
            <input id="password" type="password" autocomplete="current-password" required>
            <label for="password">Contraseña</label>
        </div>
        <button id="submit-btn" class="btn indigo darken-3 waves-effect" type="submit" style="width:100%">Ingresar</button>
        <p class="center-align">¿No tienes cuenta? <a href="/signUp">Regístrate</a></p>
    </form>
</div>
<%- include('partials/footer', { script: 'signIn' }) %>
